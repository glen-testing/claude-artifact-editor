{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "artifact-fetch",
  "description": "claude.ai pages in the import window may only emit events",
  "windows": ["artifact-fetch"],
  "remote": {
    "urls": ["https://claude.ai/*"]
  },
  "permissions": [
    "core:event:allow-emit"
  ]
}
